{
  "name": "bb-plugin-session-history",
  "version": "0.1.1",
  "private": true,
  "description": "Selectable Claude Code, Codex, Qwen Code, Pi and Command Code histories in BB, including enrolled machines.",
  "license": "MIT",
  "author": "Nikolai Marchenko (https://github.com/neonick)",
  "homepage": "https://github.com/neonick/bb-plugin-session-history#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neonick/bb-plugin-session-history.git"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "claude-code",
    "codex",
    "qwen-code",
    "pi",
    "sessions",
    "history"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Session History",
    "description": "Choose CLI histories, browse past Claude, Codex, Qwen, Pi and Command Code sessions, and continue conversations in BB.",
    "branding": {
      "icon": "Clock"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "build": "bb plugin build .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "@pierre/diffs": "~1.2.12",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  }
}
