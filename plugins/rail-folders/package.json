{
  "name": "bb-plugin-rail-folders",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Group the BB rail icons into folders, with a popover per folder and a settings section to manage them.",
  "license": "MIT",
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Rail Folders",
    "description": "Объединяйте иконки левого рейла BB в папки: клик раскрывает участников, порядок и состав настраиваются.",
    "branding": {
      "icon": "FolderTree"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
